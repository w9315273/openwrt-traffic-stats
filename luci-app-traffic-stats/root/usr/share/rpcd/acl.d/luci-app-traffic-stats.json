{
  "luci-app-traffic-stats": {
    "description": "Read traffic statistics and configure its collector",
    "read": {
      "ubus": {
        "traffic-stats": [
          "status",
          "history",
          "containers",
          "name_list"
        ],
        "uci": [
          "get",
          "changes"
        ]
      },
      "uci": [
        "traffic-stats"
      ]
    },
    "write": {
