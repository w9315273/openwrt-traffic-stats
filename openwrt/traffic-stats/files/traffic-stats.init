#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/sbin/traffic-statsd

fail_config() {
	logger -t traffic-stats -- "$1"
	echo "traffic-stats: $1" >&2
	return 1
}

valid_device() {
	case "$1" in
		''|*[!A-Za-z0-9_.-]*) return 1 ;;
	esac
	[ "${#1}" -lt 16 ]
}

valid_number() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "${#1}" -le 9 ] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

valid_path() {
	case "$1" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*/|*'
'*) return 1 ;;
	esac
}

append_proxy_container() {
	procd_append_param command --proxy-container "$1"
}

collect_lan() {
	valid_device "$1" || { device_error=1; return; }
	case " $lan_devices " in *" $1 "*) return ;; esac
	lan_devices="${lan_devices:+$lan_devices }$1"
}

collect_wan() {
	valid_device "$1" || { device_error=1; return; }
	case " $wan_devices " in *" $1 "*) return ;; esac
	wan_devices="${wan_devices:+$wan_devices }$1"
}

start_service() {
	local enabled lan wan lan_devices wan_devices device length device_error=0
	local database interval commit_interval retention retention_days leases timezone database_dir storage_dir

	config_load traffic-stats
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get lan main lan_devices __missing__
	config_get wan main wan_devices __missing__
	if [ "$lan" != __missing__ ]; then
		config_get length main lan_devices_LENGTH
		if [ -n "$length" ]; then
			config_list_foreach main lan_devices collect_lan
		else
			collect_lan "$lan"
		fi
	else
		config_get lan main lan_device br-lan
		collect_lan "$lan"
	fi
	if [ "$wan" != __missing__ ]; then
		config_get length main wan_devices_LENGTH
		if [ -n "$length" ]; then
			config_list_foreach main wan_devices collect_wan
		else
			collect_wan "$wan"
		fi
	else
		config_get wan main wan_device
		collect_wan "$wan"
	fi
	config_get database main database /etc/traffic-stats/traffic.db
	config_get storage_dir main storage_dir
	config_get interval main interval 5
	config_get commit_interval main commit_interval 60
	config_get retention main retention
	if [ -z "$retention" ]; then
		config_get retention_days main retention_days 90
		valid_number "$retention_days" 1 3650 || return 1
		retention_days=$(( (retention_days + 29) / 30 ))
		[ "$retention_days" -le 120 ] || retention_days=120
		retention="$retention_days"
	fi
	config_get leases main leases /tmp/dhcp.leases

	for device in $lan_devices; do
		case " $wan_devices " in *" $device "*) device_error=1 ;; esac
	done
	[ "$device_error" -eq 0 ] && [ -n "$lan_devices" ] && [ -n "$wan_devices" ] || {
		fail_config "Configure nonempty LAN and WAN device lists without overlap."
		return 1
	}
	valid_number "$interval" 1 3600 &&
		valid_number "$commit_interval" "$interval" 86400 || {
		fail_config "Invalid sample interval, commit interval or retention period."
		return 1
	}
	valid_path "$database" && valid_path "$leases" || {
		fail_config "Database and lease paths must be absolute file paths."
		return 1
	}

	umask 077
	database_dir=${database%/*}
	[ -n "$database_dir" ] || database_dir=/
	if [ -z "$storage_dir" ] && [ "$database_dir" = /etc/traffic-stats ]; then
		mkdir -p "$database_dir" || return 1
	fi
	[ -n "$storage_dir" ] || { [ -d "$database_dir" ] && [ -w "$database_dir" ]; } || {
		fail_config "Database directory must already exist and be writable: $database_dir"
		return 1
	}
	timezone=$(uci -q get 'system.@system[0].timezone')
	[ -n "$timezone" ] || timezone=UTC0

	procd_open_instance main
	procd_set_param command "$PROG" watch \
		--database "$database" \
		--interval "$interval" --commit-interval "$commit_interval" \
		--retention "$retention" \
		--runtime-file /var/run/traffic-stats.json --timezone "$timezone"
	for device in $lan_devices; do procd_append_param command --lan "$device"; done
	for device in $wan_devices; do procd_append_param command --wan "$device"; done
	[ "$leases" = /tmp/dhcp.leases ] || procd_append_param command --leases "$leases"
	[ -z "$storage_dir" ] || procd_append_param command --storage-dir "$storage_dir"
	config_list_foreach main proxy_containers append_proxy_container
	procd_set_param env "TZ=$timezone"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger traffic-stats system
}
